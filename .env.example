# Optional for local development; PesaTrack uses a persistent embedded PostgreSQL database by default.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/pesatrack
# Required in production. Use a unique random secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
PORT=4000
CLIENT_URL=http://localhost:5173
# Optional persistent database directory for the embedded local PostgreSQL.
# PESATRACK_DATA_DIR=./data/pesatrack
# Set to true when your PostgreSQL provider requires verified TLS.
DATABASE_SSL=false
# Only set this when the API is hosted at a different origin from the frontend.
# VITE_API_URL=https://api.example.com/api
